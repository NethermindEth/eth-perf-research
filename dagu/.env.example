# Required by docker-compose.yml. Dagu shells out to `docker compose` against
# the host daemon, so bind-mount sources must resolve to the same absolute path
# inside this container as on the host (identity mapping).
ORCHESTRATOR_HOST_DIR=/absolute/path/to/eth-perf-research/orchestrator
LAB_GENESIS_HOST_PATH=/absolute/path/to/state-benchmarks/lab-genesis.json
