{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestrator.journal.v1",
  "title": "Orchestrator journal record v1",
  "type": "object",
  "required": [
    "schema",
    "session_id",
    "ts_iso",
    "batch_id",
    "replay_core",
    "observability"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "session_id": { "type": "integer", "minimum": 1 },
    "resumed_from_batch": { "type": ["integer", "null"] },
    "ts_iso": { "type": "string" },
    "batch_id": { "type": "integer", "minimum": 0 },
    "replay_core": {
      "type": "object",
      "required": [
        "verb",
        "deadline_bytes",
        "start_address",
        "end_address",
        "status",
        "block_hash",
        "block_number",
        "chain_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "verb": { "type": "string" },
        "deadline_bytes": { "type": "integer", "minimum": 0 },
        "start_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
        "end_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
        "status": {
          "type": "string",
          "enum": ["ok", "aborted", "controller_instability", "sensor_wait_timeout"]
        },
        "block_hash": { "type": "string" },
        "block_number": { "type": "integer", "minimum": 0 },
        "chain_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "observed_flat_bytes",
        "coeffs_before",
        "coeffs_after",
        "sigma_innov",
        "alpha_current",
        "innovation_ratio",
        "residual_norm",
        "statecomp_snapshot"
      ],
      "properties": {
        "observed_flat_bytes": { "type": "integer" },
        "coeffs_before": { "type": "object" },
        "coeffs_after": { "type": "object" },
        "sigma_innov": { "type": "object" },
        "alpha_current": { "type": "number" },
        "innovation_ratio": { "type": "number" },
        "residual_norm": { "type": "number" },
        "statecomp_snapshot": { "type": ["object", "null"] }
      }
    }
  }
}
