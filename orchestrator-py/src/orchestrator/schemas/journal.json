{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orchestrator.journal.v2",
  "title": "Orchestrator journal record v2",
  "type": "object",
  "required": [
    "schema",
    "session_id",
    "ts_iso",
    "batch_id",
    "replay_core",
    "observability"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 2 },
    "session_id": { "type": "integer", "minimum": 1 },
    "resumed_from_batch": { "type": ["integer", "null"] },
    "ts_iso": { "type": "string" },
    "batch_id": { "type": "integer", "minimum": 0 },
    "replay_core": {
      "type": "object",
      "required": [
        "verb",
        "deadline_bytes",
        "start_address",
        "end_address",
        "status",
        "block_hash",
        "block_number",
        "block_timestamp",
        "target_sha256",
        "chain_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "verb": { "type": "string", "minLength": 1, "maxLength": 64 },
        "deadline_bytes": { "type": "integer", "minimum": 0, "maximum": 268435456 },
        "start_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{1,40}$" },
        "end_address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{1,40}$" },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "aborted",
            "controller_instability",
            "sensor_wait_timeout",
            "reconciled_unobserved",
            "partial_committed"
          ]
        },
        "block_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "block_number": { "type": "integer", "minimum": 0 },
        "block_timestamp": { "type": "integer", "minimum": 0 },
        "target_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "chain_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "observability": {
      "type": "object",
      "required": [
        "observed_flat_bytes",
        "coeffs_before",
        "coeffs_after",
        "sigma_innov",
        "alpha_current",
        "innovation_ratio",
        "residual_norm",
        "statecomp_snapshot"
      ],
      "properties": {
        "observed_flat_bytes": { "type": "integer" },
        "coeffs_before": { "type": "object" },
        "coeffs_after": { "type": "object" },
        "alpha_state": { "type": "object" },
        "sigma_innov": { "type": "object" },
        "alpha_current": { "type": "number" },
        "innovation_ratio": { "type": "number" },
        "residual_norm": { "type": "number" },
        "statecomp_snapshot": { "type": ["object", "null"] }
      }
    }
  }
}
